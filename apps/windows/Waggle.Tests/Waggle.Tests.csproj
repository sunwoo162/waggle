<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <None Update="Fixtures/*.webp" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Waggle.Windows/CharacterCard.cs" Link="CharacterCard.cs" />
    <Compile Include="../Waggle.Windows/DetailSelection.cs" Link="DetailSelection.cs" />
    <ProjectReference Include="../Waggle.Core/Waggle.Core.csproj" />
    <ProjectReference Include="../Waggle.Platform.Windows/Waggle.Platform.Windows.csproj" />
    <ProjectReference Include="../Waggle.Security.Windows/Waggle.Security.Windows.csproj" />
  </ItemGroup>

</Project>
