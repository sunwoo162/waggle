<Window x:Class="Waggle.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="와글" Width="960" Height="740" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closed="WindowClosed">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#EDEEF1" BorderThickness="0,0,1,0" Background="#F7F8F9" Padding="28,32">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="30" FontWeight="SemiBold" LineHeight="40"><Run Text="와글"/><Run Text="." Foreground="#00A099"/></TextBlock>
        <StackPanel Grid.Row="1" Margin="0,32,0,0"><TextBlock Text="광주소프트웨어" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="마이스터고등학교" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="우리 학교의 연결을 가볍게." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel>
        <StackPanel Grid.Row="3"><Border Background="#E0F3F4" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"><TextBlock Text="Windows · 개발 중" FontSize="12" Foreground="#105151"/></Border><TextBlock Text="지금은 계정 연결을 지원해요.&#x0a;Wi-Fi 자동 관리와 도감은&#x0a;다음 단계에서 만나요." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="44,40" MaxWidth="520" HorizontalAlignment="Stretch">
        <TextBlock Text="시작하기" Foreground="#00938B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock x:Name="PageTitle" Text="와글에 로그인" FontSize="28" FontWeight="SemiBold" LineHeight="38"/>
        <TextBlock x:Name="PageDescription" Text="운영자에게 받은 개인 코드로 시작하세요." Style="{StaticResource MutedText}" Margin="0,10,0,28"/>
        <StackPanel x:Name="LoginPanel">
          <Expander x:Name="ServerExpander" Header="서버 연결 설정" Margin="0,0,0,24" IsExpanded="True"><StackPanel Margin="0,14,0,0"><TextBlock Text="서비스 주소" Margin="0,0,0,8"/><TextBox x:Name="ServerInput" Text="http://localhost:3000" AutomationProperties.Name="서비스 주소"/><TextBlock Text="운영자가 안내한 HTTPS 주소를 입력해주세요. localhost는 개발용 서버입니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Expander>
          <TextBlock Text="개인 코드" Margin="0,0,0,8"/><PasswordBox x:Name="CodeInput" MaxLength="128" AutomationProperties.Name="개인 코드"/>
          <TextBlock Text="휴대폰에서 쓰는 코드와 같아도 괜찮아요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,20"/>
          <TextBlock Text="이 기기의 이름" Margin="0,0,0,8"/><TextBox x:Name="DeviceInput" Text="내 노트북" MaxLength="64" AutomationProperties.Name="이 기기의 이름"/>
          <TextBlock Text="운영자가 기기 세션을 구분할 때 사용합니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,24"/>
          <Button x:Name="LoginButton" Content="개인 코드로 로그인" Click="LoginClicked" IsDefault="True"/>
        </StackPanel>
        <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
          <Border BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="연결된 계정" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="AliasText" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,16"/><TextBlock x:Name="DeviceText"/><TextBlock x:Name="ExpiryText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="OriginText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
          <Button x:Name="CheckButton" Content="세션 다시 확인" Click="CheckClicked" Margin="0,24,0,10"/>
          <Button x:Name="LogoutButton" Content="이 기기에서 로그아웃" Style="{StaticResource SecondaryButton}" Click="LogoutClicked"/>
        </StackPanel>
        <Border x:Name="MessagePanel" Background="#F7F8F9" CornerRadius="8" Padding="16" Margin="0,24,0,0" Visibility="Collapsed"><TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
        <TextBlock Text="로그인 정보는 이 Windows 계정에 보호해 저장합니다. 와글을 종료해도 현재 Wi-Fi 연결은 바뀌지 않습니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,24,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>

