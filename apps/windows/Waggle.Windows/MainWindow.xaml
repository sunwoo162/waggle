<Window x:Class="Waggle.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="와글" Width="1040" Height="800" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing" Closed="WindowClosed">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="CardButton" TargetType="Button"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,16"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CardSurface" BorderBrush="#EDEEF1" BorderThickness="1" Background="White" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#0BB7AE"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#00827A"/><Setter TargetName="CardSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#EDEEF1" BorderThickness="0,0,1,0" Padding="24,32" Background="#FCFDFD">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="28" FontWeight="SemiBold" LineHeight="38"><Run Text="와글"/><Run Text="." Foreground="#00A099"/></TextBlock>
        <StackPanel Grid.Row="1" Margin="0,24,0,0"><TextBlock Text="광주소프트웨어&#x0a;마이스터고등학교" FontSize="12" LineHeight="20"/><StackPanel Margin="0,32,0,0"><Button x:Name="HomeNav" Content="나의 연결" Tag="home" Style="{StaticResource NavButton}" Click="NavigateClicked"/><Button x:Name="CollectionNav" Content="와이파이 도감" Tag="collection" Style="{StaticResource NavButton}" Click="NavigateClicked"/><Button x:Name="AccountNav" Content="내 계정" Tag="account" Style="{StaticResource NavButton}" Click="NavigateClicked"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="3"><Border Background="#E0F3F4" CornerRadius="8" Padding="12,10"><TextBlock x:Name="TrayStateText" Text="자동 관리 꺼짐" Foreground="#105151" FontSize="12"/></Border><TextBlock Text="Windows · 개발 중" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,24"><TextBlock x:Name="PageTitle" Text="와글에 로그인" FontSize="28" FontWeight="SemiBold" LineHeight="38"/><TextBlock x:Name="PageDescription" Text="운영자에게 받은 개인 코드로 시작하세요." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
      <Border Grid.Row="1" x:Name="MessagePanel" Background="#E0F3F4" CornerRadius="8" Padding="16" Margin="0,0,0,20" Visibility="Collapsed"><TextBlock x:Name="MessageText" Foreground="#105151" AutomationProperties.LiveSetting="Polite"/></Border>
      <Grid Grid.Row="2">
        <ScrollViewer x:Name="LoginPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="420" HorizontalAlignment="Center" Margin="16,8,16,24">
          <Expander x:Name="ServerExpander" Header="서버 연결 설정" IsExpanded="True" Margin="0,0,0,24"><StackPanel Margin="0,12,0,0"><TextBlock Text="서비스 주소" Margin="0,0,0,8"/><TextBox x:Name="ServerInput" Text="http://localhost:3000" AutomationProperties.Name="서비스 주소"/><TextBlock Text="운영자가 안내한 HTTPS 주소를 입력해주세요. localhost는 개발용 서버예요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Expander>
          <TextBlock Text="개인 코드" Margin="0,0,0,8"/><PasswordBox x:Name="CodeInput" MaxLength="128" AutomationProperties.Name="개인 코드"/><TextBlock Text="휴대폰과 노트북에서 같은 코드를 사용할 수 있어요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,20"/>
          <TextBlock Text="이 기기의 이름" Margin="0,0,0,8"/><TextBox x:Name="DeviceInput" Text="내 노트북" MaxLength="64" AutomationProperties.Name="이 기기의 이름"/><TextBlock Text="기기 세션을 구분할 때 사용해요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,24"/><Button x:Name="LoginButton" Content="개인 코드로 로그인" Click="LoginClicked" IsDefault="True"/>
          <TextBlock Text="로그인 정보와 학교 접속정보는 이 Windows 계정에 보호해 저장해요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,20,0,0"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="HomePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,24">
          <Border Background="#F7F8F9" CornerRadius="16" Padding="24"><StackPanel><TextBlock x:Name="ConnectionStateText" Text="연결 상태 확인 전" Foreground="#105151" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionNameText" Text="관리 시작으로 연결을 확인해요" FontSize="22" FontWeight="SemiBold" LineHeight="32" Margin="0,8,0,0"/><TextBlock x:Name="QualityText" Text="신호 품질과 실제 연결 결과를 확인해요." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock x:Name="ObservedAtText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
          <Border BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,24,0,0"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="자동 관리" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ManagementStateText" Text="꺼짐" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StartButton" Content="관리 시작" Click="StartClicked"/><Button x:Name="PauseButton" Content="일시 중지" Click="PauseClicked" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/></StackPanel></Grid>
            <TextBlock Text="사용할 Wi-Fi 어댑터" FontSize="12" Margin="0,24,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AdapterInput" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="40" FontSize="14" Padding="8" AutomationProperties.Name="사용할 Wi-Fi 어댑터"/><Button x:Name="InterfacesButton" Grid.Column="1" Content="어댑터 확인" Style="{StaticResource SecondaryButton}" Click="InterfacesClicked" Margin="8,0,0,0"/></Grid>
            <CheckBox x:Name="ConsentInput" Margin="0,20,0,0" VerticalContentAlignment="Center"><TextBlock Text="학교 Wi-Fi를 이 기기에 저장하고 자동으로 연결을 요청하도록 허용해요." FontSize="12" LineHeight="20"/></CheckBox>
            <TextBlock x:Name="ManagementHintText" Text="신호가 충분하면 연결을 유지하고, 나빠지면 더 나은 학교망 후보를 확인해요. 신호 세기가 실제 속도를 보장하지는 않아요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/>
            <TextBlock Text="관리 중 창을 닫으면 트레이에서 계속 실행해요. 일시 중지는 현재 Wi-Fi 연결을 끊지 않아요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="이 기기의 최근 기록" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="최근 200개까지 이 기기에만 보관해요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ClearHistoryButton" Content="기록 비우기" Style="{StaticResource SecondaryButton}" Click="ClearHistoryClicked"/></Grid><TextBlock x:Name="HistoryText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0" Text="아직 연결 기록이 없어요."/>
        </StackPanel></ScrollViewer>
        <Grid x:Name="CollectionPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CollectionCountText" Text="0 / 0명 발견" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CollectionSyncText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel><Button x:Name="CollectionRefreshButton" Grid.Column="1" Content="동기화" Style="{StaticResource SecondaryButton}" Click="RefreshClicked"/></Grid>
          <ProgressBar x:Name="CollectionProgress" Grid.Row="1" Height="6" Background="#EDEEF1" Foreground="#0BB7AE" BorderThickness="0" Margin="0,16,12,24" Maximum="1"/>
          <Grid Grid.Row="2"><TextBlock x:Name="GalleryEmptyText" Text="아직 준비된 친구가 없어요. 잠시 후 다시 확인해주세요." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ListBox x:Name="GalleryRows" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource CardButton}" Click="CharacterClicked" AutomationProperties.Name="{Binding AccessibleName}"><StackPanel><Border Background="#F7F8F9" CornerRadius="12" Height="144"><Grid><Image Source="{Binding Picture}" Stretch="Uniform" Loaded="CharacterImageLoaded" DataContextChanged="CharacterImageContextChanged"/><TextBlock Text="◌" FontSize="48" Foreground="#C1C7D1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Placeholder}"/></Grid></Border><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="{Binding Caption}" Foreground="#636978" FontSize="12" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,8,24"><Border BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="연결된 계정" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="AliasText" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,16"/><TextBlock x:Name="DeviceText"/><TextBlock x:Name="ExpiryText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="OriginText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><Button x:Name="CheckButton" Content="계정·설정 다시 확인" Click="RefreshClicked" Margin="0,24,0,12"/><Button x:Name="LogoutButton" Content="이 기기에서 로그아웃" Style="{StaticResource SecondaryButton}" Click="LogoutClicked"/><TextBlock Text="같은 계정의 휴대폰·노트북에서 친구들을 함께 모아요. 로그아웃은 이 기기의 로그인 정보와 동기화 대기 자료를 정리해요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,24,0,0"/><TextBlock Text="로그아웃하면 와글이 이 PC에 등록한 학교 Wi-Fi도 지워서, 그 Wi-Fi에 연결돼 있었다면 연결이 끊길 수 있어요. 와글 종료는 등록을 유지해요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
        <Border x:Name="CharacterDetail" Visibility="Collapsed" Background="White" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="16" Padding="32"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="닫기" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="CloseDetailClicked"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel HorizontalAlignment="Center" MaxWidth="420" Margin="0,16,0,24"><Border Background="#F7F8F9" CornerRadius="16" Width="256" Height="256"><Grid><Image Source="{Binding Picture}" Stretch="Uniform" Loaded="CharacterImageLoaded" DataContextChanged="CharacterImageContextChanged"/><TextBlock Text="◌" FontSize="64" Foreground="#C1C7D1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Placeholder}"/></Grid></Border><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,0"/><TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding Story}" TextAlignment="Center" Margin="0,24,0,0"/></StackPanel></ScrollViewer></Grid></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
